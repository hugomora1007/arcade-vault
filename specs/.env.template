# Copia estas variables a `.env.local` (ignorado por git) y rellena los valores.
# Solo servidor: nunca uses el prefijo NEXT_PUBLIC_ con estas variables.

# API key de Resend (https://resend.com/api-keys)
RESEND_API_KEY=re_xxxxxxxxxxxx

# Destinatario de los mensajes del formulario de contacto.
# En el sandbox de Resend solo se entrega al correo dueño de la cuenta de Resend.
CONTACT_TO_EMAIL=hugomora34@hotmail.com

# Remitente. En sandbox usa onboarding@resend.dev; con dominio verificado, cambia solo esta variable.
CONTACT_FROM_EMAIL=onboarding@resend.dev
